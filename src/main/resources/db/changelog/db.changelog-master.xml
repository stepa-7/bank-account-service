<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="1" author="assistant">
        <createTable tableName="accounts">
            <column name="id" type="uuid" valueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_currency" type="decimal(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_rub" type="decimal(19,4)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="assistant">
        <createTable tableName="currency_rates">
            <column name="id" type="uuid" valueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="rate" type="decimal(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" valueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="assistant">
        <insert tableName="currency_rates">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="code" value="USD" />
            <column name="rate" valueNumeric="1.0" />
            <column name="updated_at" valueDate="2025-01-01T00:00:00" />
        </insert>
    </changeSet>
</databaseChangeLog>